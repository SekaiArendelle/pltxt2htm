# Generated by gen_tidy_ninja.py
rule tidy_cpp
  command = clang-tidy --quiet $in -- -std=c++23 -Iinclude
  description = Tidying C++ $in

rule tidy_c
  command = clang-tidy --quiet $in -- -std=c99 -Iinclude
  description = Tidying C $in

build c_examples_example_c_tidy: tidy_c c/examples/example.c
build c_src_pltxt2htm_cc_tidy: tidy_cpp c/src/pltxt2htm.cc
build cmd_pltxt2htm_cc_tidy: tidy_cpp cmd/pltxt2htm.cc
build examples_common_cc_tidy: tidy_cpp examples/common.cc
build examples_fixedadv_cc_tidy: tidy_cpp examples/fixedadv.cc
build examples_unity-richtext_cc_tidy: tidy_cpp examples/unity-richtext.cc

build tidy: phony c_examples_example_c_tidy c_src_pltxt2htm_cc_tidy cmd_pltxt2htm_cc_tidy examples_common_cc_tidy examples_fixedadv_cc_tidy examples_unity-richtext_cc_tidy

default tidy
