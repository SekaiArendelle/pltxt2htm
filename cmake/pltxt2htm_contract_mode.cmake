set(PLTXT2HTM_CONTRACT_MODE "AUTO" CACHE STRING "Contract mode: AUTO, ENFORCE, or IGNORE")
set_property(CACHE PLTXT2HTM_CONTRACT_MODE PROPERTY STRINGS AUTO ENFORCE IGNORE)
string(TOUPPER "${PLTXT2HTM_CONTRACT_MODE}" _pltxt2htm_contract_mode)
if(NOT _pltxt2htm_contract_mode MATCHES "^(AUTO|ENFORCE|IGNORE)$")
    message(FATAL_ERROR "PLTXT2HTM_CONTRACT_MODE must be AUTO, ENFORCE, or IGNORE")
endif()
set(PLTXT2HTM_CONTRACT_MODE "${_pltxt2htm_contract_mode}" CACHE STRING "Contract mode: AUTO, ENFORCE, or IGNORE" FORCE)
function(pltxt2htm_apply_contract_mode target visibility)
    if(ARGC GREATER 2)
        set(_pltxt2htm_target_contract_mode "${ARGV2}")
    else()
        set(_pltxt2htm_target_contract_mode "${PLTXT2HTM_CONTRACT_MODE}")
    endif()
    if(_pltxt2htm_target_contract_mode STREQUAL "ENFORCE")
        target_compile_definitions("${target}" ${visibility} PLTXT2HTM_CONTRACTS=0)
    elseif(_pltxt2htm_target_contract_mode STREQUAL "IGNORE")
        target_compile_definitions("${target}" ${visibility} PLTXT2HTM_CONTRACTS=1)
    elseif(_pltxt2htm_target_contract_mode STREQUAL "AUTO")
        target_compile_definitions("${target}" ${visibility} "$<$<CONFIG:Release>:PLTXT2HTM_CONTRACTS=1>")
    else()
        message(FATAL_ERROR "Invalid contract mode for target ${target}: ${_pltxt2htm_target_contract_mode}")
    endif()
endfunction()
