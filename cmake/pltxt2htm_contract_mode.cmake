set(PLTXT2HTM_CONTRACT_MODE "AUTO" CACHE STRING "Contract mode: AUTO, ENFORCE, QUICK_ENFORCE, or IGNORE")
set_property(CACHE PLTXT2HTM_CONTRACT_MODE PROPERTY STRINGS AUTO ENFORCE QUICK_ENFORCE IGNORE)
string(TOUPPER "${PLTXT2HTM_CONTRACT_MODE}" _pltxt2htm_contract_mode)
if(NOT _pltxt2htm_contract_mode MATCHES "^(AUTO|ENFORCE|QUICK_ENFORCE|IGNORE)$")
    message(FATAL_ERROR "PLTXT2HTM_CONTRACT_MODE must be AUTO, ENFORCE, QUICK_ENFORCE, or IGNORE")
endif()
set(PLTXT2HTM_CONTRACT_MODE "${_pltxt2htm_contract_mode}" CACHE STRING "Contract mode: AUTO, ENFORCE, QUICK_ENFORCE, or IGNORE" FORCE)
function(pltxt2htm_apply_contract_mode target visibility)
    if(ARGC GREATER 2)
        set(_pltxt2htm_requested_contract_mode "${ARGV2}")
    else()
        set(_pltxt2htm_requested_contract_mode "${PLTXT2HTM_CONTRACT_MODE}")
    endif()
    if(NOT _pltxt2htm_requested_contract_mode MATCHES "^(AUTO|ENFORCE|QUICK_ENFORCE|IGNORE)$")
        message(FATAL_ERROR "Invalid contract mode for target ${target}: ${_pltxt2htm_requested_contract_mode}")
    endif()

    # AUTO is resolved to one concrete mode at configure time. Multi-config
    # generators select the configuration at build time, so AUTO resolves to
    # enforce there; request IGNORE explicitly to disable checks in that case.
    set(_pltxt2htm_target_contract_mode "${_pltxt2htm_requested_contract_mode}")
    if(_pltxt2htm_target_contract_mode STREQUAL "AUTO")
        if(CMAKE_CONFIGURATION_TYPES)
            set(_pltxt2htm_target_contract_mode "ENFORCE")
            set(_pltxt2htm_resolved_contract_mode "enforce (multi-config; request IGNORE explicitly to disable checks)")
        else()
            string(TOUPPER "${CMAKE_BUILD_TYPE}" _pltxt2htm_build_type)
            if(_pltxt2htm_build_type STREQUAL "RELEASE")
                set(_pltxt2htm_target_contract_mode "IGNORE")
                set(_pltxt2htm_resolved_contract_mode "ignore (Release)")
            elseif(CMAKE_BUILD_TYPE)
                set(_pltxt2htm_target_contract_mode "ENFORCE")
                set(_pltxt2htm_resolved_contract_mode "enforce (${CMAKE_BUILD_TYPE})")
            else()
                set(_pltxt2htm_target_contract_mode "ENFORCE")
                set(_pltxt2htm_resolved_contract_mode "enforce (no CMAKE_BUILD_TYPE)")
            endif()
        endif()
    elseif(_pltxt2htm_target_contract_mode STREQUAL "ENFORCE")
        set(_pltxt2htm_resolved_contract_mode "enforce")
    elseif(_pltxt2htm_target_contract_mode STREQUAL "QUICK_ENFORCE")
        set(_pltxt2htm_resolved_contract_mode "quick_enforce")
    elseif(_pltxt2htm_target_contract_mode STREQUAL "IGNORE")
        set(_pltxt2htm_resolved_contract_mode "ignore")
    endif()

    if(_pltxt2htm_target_contract_mode STREQUAL "ENFORCE")
        set(_pltxt2htm_contract_definition "PLTXT2HTM_CONTRACTS=0")
    elseif(_pltxt2htm_target_contract_mode STREQUAL "QUICK_ENFORCE")
        set(_pltxt2htm_contract_definition "PLTXT2HTM_CONTRACTS=1")
    elseif(_pltxt2htm_target_contract_mode STREQUAL "IGNORE")
        set(_pltxt2htm_contract_definition "PLTXT2HTM_CONTRACTS=2")
    else()
        message(FATAL_ERROR "Unresolved contract mode for target ${target}: ${_pltxt2htm_target_contract_mode}")
    endif()
    target_compile_definitions("${target}" ${visibility} ${_pltxt2htm_contract_definition})
    message(STATUS "pltxt2htm: '${target}' contract mode: ${_pltxt2htm_requested_contract_mode} -> ${_pltxt2htm_resolved_contract_mode}")
endfunction()
